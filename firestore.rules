rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@cit\\.edu$') ||
        request.auth.token.email == 'admin@citdevhub.edu' ||
        request.auth.token.email == 'pradhanv2409@gmail.com'
      );
    }

    // Events collection:
    // Anyone can read published events. Only admins can read drafts or create/update/delete.
    match /events/{eventId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Certificate Templates:
    // Templates readable by public for rendering, writable only by admins.
    match /templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Approved Attendees:
    // Confidential registry. Public users CANNOT list all attendees.
    // Attendees can only be read/validated individually or managed by Admin.
    match /participants/{participantId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Issued Certificates:
    // Anyone can read/verify a single certificate record by its certificateId.
    // Issuance allowed through server logic or verified attendance. Modifying or revoking restricted to admins.
    match /issued_certificates/{certId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['certificateId', 'eventId', 'participantName', 'issuedAt'])
                    && request.resource.data.revoked == false;
      allow update, delete: if isAdmin();
    }
  }
}
